# ============================================================
# Runtime — 基于 Builder 基础环境的极速精简运行镜像
# 彻底移除 Nuitka 编译流程，直接在 Python 容器内高效运行
# ============================================================
ARG BASE=ghcr.io/mengkzhaoyun/jasna:v0.10.0-build
FROM ${BASE}

ARG AUTHOR
ARG VERSION
LABEL maintainer=${AUTHOR} version=${VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV SCAN_DIR=/data
ENV CODEC=hevc
ENV ENCODER_CQ=20
ENV TARGET_BITRATE=5M
ENV EXTRA_ARGS=
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics

# 安装多媒体命令行工具与运行时组件
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg mkvtoolnix \
    libxml2 librsvg2-2 libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# 确保 CUDA 库软链接与环境变量正确
RUN for f in /usr/local/cuda/lib64/libnpp*.so.13; do ln -s "$f" "${f%.13}" 2>/dev/null || true; done
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

WORKDIR /app/jasna
COPY . /app/jasna

# 极速安装当前版本 jasna（无依赖重复下载）并创建 sglang 兼容入口
RUN pip install --no-cache-dir --no-deps . && \
    mkdir -p /app/sglang/model_weights && \
    printf '#!/bin/bash\nexec python3.13 -m jasna "$@"\n' > /app/sglang/sglang && \
    chmod +x /app/sglang/sglang && \
    ln -sf /app/sglang/sglang /usr/local/bin/sglang

# 入口脚本
COPY .drone/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]

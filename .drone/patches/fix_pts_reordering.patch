+def _batched_reordered_frames(reader, seek_ts, batch_size: int, max_depth: int = 32):
+    buffer = []
+    seq = 0
+    batch_f = []
+    batch_p = []
+    
+    for batch_tensor, pts_list in reader.frames(seek_ts=seek_ts):
+        for i in range(len(pts_list)):
+            pts = pts_list[i]
+            frame = batch_tensor[i].clone()
+            heapq.heappush(buffer, (pts, seq, frame))
+            seq += 1
+            
+            if len(buffer) > max_depth:
+                p, _, f = heapq.heappop(buffer)
+                batch_f.append(f)
+                batch_p.append(p)
+                if len(batch_f) == batch_size:
+                    yield torch.stack(batch_f), batch_p
+                    batch_f = []
+                    batch_p = []
+                    
+    while buffer:
+        p, _, f = heapq.heappop(buffer)
+        batch_f.append(f)
+        batch_p.append(p)
+        if len(batch_f) == batch_size:
+            yield torch.stack(batch_f), batch_p
+            batch_f = []
+            batch_p = []
+            
+    if batch_f:
+        yield torch.stack(batch_f), batch_p
+
+
+def _flat_reordered_frames(reader, seek_ts, max_depth: int = 32):
+    buffer = []
+    seq = 0
+    for batch_tensor, pts_list in reader.frames(seek_ts=seek_ts):
+        for i in range(len(pts_list)):
+            pts = pts_list[i]
+            frame = batch_tensor[i].clone()
+            heapq.heappush(buffer, (pts, seq, frame))
+            seq += 1
+            
+            if len(buffer) > max_depth:
+                _, _, f = heapq.heappop(buffer)
+                yield f
+                
+    while buffer:
+        _, _, f = heapq.heappop(buffer)
+        yield f
+
+
